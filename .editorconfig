# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md,toml}]
indent_size = 2

[*.{ps1,bat,cmd}]
end_of_line = crlf

[*.sh]
end_of_line = lf
